.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Local data: the run database, uploads and exports may hold confidential statements.
var/
*.sqlite
*.sqlite3
*.db

# SEC filings are re-downloaded from eval/sec/manifest.json; only the manifest and keys are kept.
eval/sec/raw/
eval/sec/cal/

# Frontend build and dependencies
web/node_modules/
web/dist/

.env
.env.*
!.env.example

# Printed SEC PDFs are regenerated by scripts/print_sec_pdfs.py
eval/sec/pdf/*.pdf

# Prior-year SEC filings for the company-memory evaluation (scripts/fetch_sec.py --prior); re-downloadable
eval/sec/raw-prior/
eval/sec/cal-prior/

# Filings for the industry and IFRS overlays (scripts/fetch_coverage.py); re-downloadable
eval/coverage/raw/
