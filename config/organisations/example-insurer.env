# A second example organisation: an insurer analysing other insurers' statements, signing in with Okta, keeping
# records under the default policy (nothing deleted automatically) and using the default payables policy.
FINOPS_ORGANISATION=example-insurer
FINOPS_AUTH_CONFIG=config/finops/auth/example-okta.yaml
SPREADER_PROFILE=config/profiles/us-insurer.yaml
FINOPS_RETENTION_POLICY=config/finops/retention/default.yaml
FINOPS_AP_POLICY=config/finops/invoice/default-ap.yaml
