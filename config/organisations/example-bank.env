# An example organisation: a US bank that spreads borrowers' statements and pays its own suppliers.
# Everything that differs between organisations is named here; paths are relative to the repository.
# Run: .venv/Scripts/spreader serve --org config/organisations/example-bank.env
FINOPS_ORGANISATION=example-bank
FINOPS_AUTH_CONFIG=config/finops/auth/example-entra-id.yaml
SPREADER_PROFILE=config/profiles/example-lender-overlay.yaml
FINOPS_RETENTION_POLICY=config/finops/retention/example-seven-years.yaml
FINOPS_AP_POLICY=config/finops/invoice/example-company-strict.yaml
